# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP - get App Password from myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Sender Profile - auto-filled on first run if empty
SENDER_NAME=Your Full Name
SENDER_COLLEGE=Your College Name
SENDER_PHONE=Your Phone Number
SENDER_GITHUB=https://github.com/your_username
SENDER_LINKEDIN=https://linkedin.com/in/your_username
SENDER_EMAIL=your_email@gmail.com
